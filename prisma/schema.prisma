generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentStatus {
  AVAILABLE
  ON_SITE
  MAINTENANCE

  @@map("equipment_status")
}

enum BookingStatus {
  PENDING_APPROVAL
  AWAITING_PAYMENT
  PAID_IN_ESCROW
  COMPLETED

  @@map("booking_status")
}

model Equipment {
  id                String          @id @default(cuid())
  ownerId           String          @map("owner_id")
  name              String
  hourlyRate        Decimal         @map("hourly_rate") @db.Decimal(12, 2)
  baseDeliveryFee   Decimal         @default(3500.00) @map("base_delivery_fee") @db.Decimal(12, 2)
  ratePerKm         Decimal         @default(70.00) @map("rate_per_km") @db.Decimal(12, 2)
  status            EquipmentStatus @default(AVAILABLE)
  nextAvailableDate DateTime?       @map("next_available_date") @db.Timestamptz(3)
  bookings          Booking[]

  @@index([ownerId])
  @@map("equipment")
}

model Booking {
  id                  String        @id @default(cuid())
  equipmentId         String        @map("equipment_id")
  renterId            String        @map("renter_id")
  rentalHours         Int           @map("rental_hours")
  distanceKm          Decimal       @map("distance_km") @db.Decimal(10, 3)
  rentalCost          Decimal       @map("rental_cost") @db.Decimal(12, 2)
  baseDeliveryFee     Decimal       @map("base_delivery_fee") @db.Decimal(12, 2)
  travelCharge        Decimal       @map("travel_charge") @db.Decimal(12, 2)
  grossTotal          Decimal       @map("gross_total") @db.Decimal(12, 2)
  platformFeeRetained Decimal       @map("platform_fee_retained") @db.Decimal(12, 2)
  ownerNetPayout      Decimal       @map("owner_net_payout") @db.Decimal(12, 2)
  startDate           DateTime?     @map("start_date") @db.Date
  endDate             DateTime?     @map("end_date") @db.Date
  bookingStatus       BookingStatus @default(PENDING_APPROVAL) @map("booking_status")
  paymentCheckoutSessionId String?  @unique @map("payment_checkout_session_id")
  paymentCheckoutUrl  String?       @map("payment_checkout_url")
  paymentId           String?       @map("payment_id")
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  equipment           Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@index([equipmentId, bookingStatus])
  @@index([renterId])
  @@index([bookingStatus, paidAt])
  @@map("bookings")
}
